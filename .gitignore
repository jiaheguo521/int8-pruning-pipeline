# Virtual environments
pruning-env/
onnx2tf-env/
venv/
.venv/
env/

# Python build / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Datasets (downloaded by examples/download_datasets.py)
data/datasets/
data/dataset/

# Pipeline products (regenerated by the pipeline; live under outputs/)
# outputs/pruning_logs/ is NOT ignored so per-run summary JSONs can be
# committed selectively; the .log files there are caught by *.log below.
outputs/

# Logs and run outputs
logs/
*.log

# Local editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local Claude state
.claude/
CLAUDE.md

# Compiled Edge TPU binaries (large; regenerated by int8_pruning.compile_edgetpu)
*_edgetpu.tflite

# Model binaries never enter git.
*.pt
*.tflite

# onnx2tf numpy-2 workaround dummy, written to the working directory by the onnx2tf
# export path (int8_pruning/export/_onnx2tf.py).
calibration_image_sample_data_*.npy
