# Virtual environments
pruning-env/
venv/
.venv/
env/

# Python build / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Datasets (downloaded by scripts/download_data_and_weights.sh)
data/datasets/
data/dataset/

# Pipeline products (regenerated by the pipeline; live under outputs/)
# outputs/pruning_logs/ is NOT ignored so per-run summary JSONs can be
# committed selectively; the .log files there are caught by *.log below.
outputs/

# Logs and run outputs
logs/
*.log

# ...except run logs promoted into results/, which are cited as evidence by
# docs/PRUNING_HAZARDS.md and must survive the sync. Must mirror the same rule
# in the dev repo's .gitignore, or the files reach the public tree and are then
# silently untracked by the sync script's ignored-tracked sweep.
!results/**/*.log

# Local editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local Claude state
.claude/
CLAUDE.md

# Compiled Edge TPU binaries (large; regenerated by compile_edgetpu.sh)
*_edgetpu.tflite

# Model binaries never enter git — they are published to HuggingFace and
# fetched by scripts/fetch_deliverables.sh. The rules above only covered
# *_edgetpu.tflite and *.log, which left deliverables/*/checkpoints_pytorch/
# and models_int8_tflite/ committable; a single `git add -A` then pulled in
# ~700 MB of .pt/.tflite. Ignore the payload directories outright and keep
# the text half (README, reference/*.json) tracked.
# The whole tree is generated: scripts/deliver.sh assembles it from outputs/,
# and reference/*.py are copies of the family modules, not source files.
/deliverables/
*.pt
*.tflite

# onnx2tf numpy-2 workaround dummy. Nothing writes this any more (the onnx2tf
# path was retired 2026-08-22); kept so old working trees stay clean.
calibration_image_sample_data_*.npy
